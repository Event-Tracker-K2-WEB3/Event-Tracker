### 5. Create event - AI & Data Workshop
POST {{baseUrl}}/events
Content-Type: application/json

{
  "title": "AI & Data Workshop",
  "description": "Workshop autour de l’intelligence artificielle, du Machine Learning et de la data.",
  "startDate": "{{$isoTimestamp}}",
  "endDate": "2030-12-31T23:59:59Z",
  "location": "Antananarivo"
}

> {%
    client.global.set("eventAiId", response.body.id);
%}


### 6. Create event - Tech Summit
POST {{baseUrl}}/events
Content-Type: application/json

{
  "title": "Tech Summit Paris 2026",
  "description": "Conférence technologique sur l’IA, le cloud, le web et les métiers numériques.",
  "startDate": "2030-01-10T08:00:00Z",
  "endDate": "2030-01-10T18:00:00Z",
  "location": "Paris"
}

> {%
    client.global.set("eventTechId", response.body.id);
%}


### 7. Create speaker - Alexandre Moreau
POST {{baseUrl}}/speakers
Content-Type: application/json

{
  "name": "Alexandre Moreau",
  "role": "Expert en Intelligence Artificielle",
  "specialty": "IA",
  "company": "TechVision",
  "bio": "Alexandre accompagne les entreprises dans l’intégration de l’IA pour optimiser leurs processus.",
  "photo": "/images/speakers/alexandre-moreau.jpg",
  "initials": "AM",
  "linkedin": "https://linkedin.com",
  "twitter": "https://twitter.com",
  "website": "https://exemple.com",
  "day": "Jour 1",
  "sessionType": "Conférence"
}

> {%
    client.global.set("speakerAlexandreId", response.body.id);
%}


