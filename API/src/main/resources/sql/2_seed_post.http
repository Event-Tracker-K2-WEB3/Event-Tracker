@baseUrl = http://localhost:8080

### 1. Create room - Main Hall
POST {{baseUrl}}/rooms
Content-Type: application/json

{
  "name": "Main Hall"
}

> {%
    client.global.set("roomMainHallId", response.body.id);
%}


### 2. Create room - Amphitheater A
POST {{baseUrl}}/rooms
Content-Type: application/json

{
  "name": "Amphitheater A"
}

> {%
    client.global.set("roomAmphitheaterAId", response.body.id);
%}


### 3. Create room - Room B
POST {{baseUrl}}/rooms
Content-Type: application/json

{
  "name": "Room B"
}

> {%
    client.global.set("roomBId", response.body.id);
%}


### 4. Create room - Workshop Lab
POST {{baseUrl}}/rooms
Content-Type: application/json

{
  "name": "Workshop Lab"
}

> {%
    client.global.set("roomWorkshopLabId", response.body.id);
%}


### 5. Create event - AI & Data Workshop
POST {{baseUrl}}/events
Content-Type: application/json

{
  "title": "AI & Data Workshop",
  "description": "A practical workshop about artificial intelligence, machine learning and data-driven innovation.",
  "startDate": "{{$isoTimestamp}}",
  "endDate": "2030-12-31T23:59:59Z",
  "location": "Antananarivo"
}

> {%
    client.global.set("eventAiId", response.body.id);
%}


### 6. Create event - Tech Summit
POST {{baseUrl}}/events
Content-Type: application/json

{
  "title": "Tech Summit Paris 2026",
  "description": "A technology conference focused on AI, cloud, web development and digital careers.",
  "startDate": "2030-01-10T08:00:00Z",
  "endDate": "2030-01-10T18:00:00Z",
  "location": "Paris"
}

> {%
    client.global.set("eventTechId", response.body.id);
%}


### 7. Create speaker - Alexandre Moreau
POST {{baseUrl}}/speakers
Content-Type: application/json

{
  "name": "Alexandre Moreau",
  "role": "Artificial Intelligence Expert",
  "specialty": "AI",
  "company": "TechVision",
  "bio": "Alexandre helps companies integrate AI to optimize their business processes.",
  "photo": "/images/speakers/alexandre-moreau.jpg",
  "initials": "AM",
  "linkedin": "https://linkedin.com",
  "twitter": "https://twitter.com",
  "website": "https://example.com",
  "day": "Day 1",
  "sessionType": "Conference"
}

> {%
    client.global.set("speakerAlexandreId", response.body.id);
%}


