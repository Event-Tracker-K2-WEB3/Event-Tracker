### ============================================
### 2. CRÉATION DE L'ÉVÉNEMENT (EN COURS)
### ============================================

POST {{baseUrl}}/events
Content-Type: application/json

{
  "title": "Dev Summit 2026",
  "description": "Le plus grand rassemblement de développeurs francophones. 3 jours de conférences, ateliers et networking autour des technologies web, cloud, IA et mobilité.",
  "startDate": "2026-05-27T09:00:00Z",
  "endDate": "2026-05-29T18:00:00Z",
  "location": "Paris, France"
}

> {%
    client.global.set("eventDevSummitId", response.body.id);
%}


